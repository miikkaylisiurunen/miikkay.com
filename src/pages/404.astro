---
import Layout from '../layouts/Layout.astro';
import InlineLink from '../components/InlineLink.astro';
import Paragraph from '../components/Paragraph.astro';
---

<Layout title="Page not found" noindex>
  <div class="h-screen flex flex-col items-center justify-center p-6">
    <div class="space-y-6">
      <div class="flex space-x-5 justify-center items-center">
        <h1 class="text-2xl font-semibold text-zinc-800 dark:text-zinc-200">404</h1>
        <span class="h-14 w-px bg-zinc-400 dark:bg-zinc-600 shrink-0"></span>
        <Paragraph>This page could not be found.</Paragraph>
      </div>
      <div class="text-center">
        <InlineLink href="/">Return home</InlineLink>
      </div>
    </div>
  </div>
</Layout>
