---
interface Props {
  href: string;
  external?: boolean;
}

const { href, external = false } = Astro.props;
---

<a
  class="text-zinc-800 dark:text-zinc-300 underline decoration-zinc-400 dark:decoration-zinc-300/50"
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noreferrer' : undefined}
>
  <slot />
</a>
